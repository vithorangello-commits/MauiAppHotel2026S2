<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2026S2.Views.Sobre"
             Title="Sobre">

    <VerticalStackLayout Padding="10" VerticalOptions="Center">

        <Label Text="Sobre o App"
               FontSize="40"
               Margin="0, 50, 0, 50" />

        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource Gray600}">
            <VerticalStackLayout Padding="15" Spacing="10">
                <Label Text="App: Hotel - Cálculo da Diária" />
                <Label Text="Desenvolvedor: SEU NOME AQUI" />
                <Label Text="Ano de desenvolvimento: 2026" />
                <Label Text="Curso Técnico - Etec" />
                <Label Text="Versão: 1.0" />
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>