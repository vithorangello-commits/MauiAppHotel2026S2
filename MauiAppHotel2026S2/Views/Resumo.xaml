<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2026S2.Views.Resumo"
             BackgroundColor="#0d1b2a"
             Title="Resumo">

    <ScrollView>
        <VerticalStackLayout Padding="10" VerticalOptions="Center">

            <Label Text="Resumo da Reserva"
                   FontSize="40"
                   TextColor="#ffb703"
                   Margin="0, 40, 0, 40" />

            <Border StrokeShape="RoundRectangle 10"
                    BackgroundColor="#1b263b">
                <VerticalStackLayout Padding="15" Spacing="10">
                    <Label TextColor="White" Text="{Binding Quarto, StringFormat='Acomodação: {0}'}" />
                    <Label TextColor="White" Text="{Binding CheckIn, StringFormat='Check-in: {0:dd/MM/yyyy}'}" />
                    <Label TextColor="White" Text="{Binding CheckOut, StringFormat='Check-out: {0:dd/MM/yyyy}'}" />
                    <Label TextColor="White" Text="{Binding Noites, StringFormat='Noites: {0}'}" />
                    <Label TextColor="White" Text="{Binding Adultos, StringFormat='Adultos: {0}'}" />
                    <Label TextColor="White" Text="{Binding Criancas, StringFormat='Crianças: {0}'}" />
                    <Label TextColor="White" Text="{Binding ValorDiaria, StringFormat='Valor da diária: R$ {0:N2}'}" />
                    <Label TextColor="#e07a5f" FontSize="26"
                           Text="{Binding ValorTotal, StringFormat='Total: R$ {0:N2}'}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Confirmar Reserva"
                    Clicked="Confirmar_Clicked"
                    BackgroundColor="#e07a5f"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0, 20, 0, 0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>