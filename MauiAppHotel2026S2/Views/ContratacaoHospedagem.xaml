<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2026S2.Views.ContratacaoHospedagem"
             BackgroundColor="#0d1b2a"
             Title="Hotel">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#e07a5f" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="10" VerticalOptions="Center">

            <Label Text="Cálculo da Diária"
                   FontSize="40"
                   TextColor="#ffb703"
                   Margin="0, 40, 0, 40" />

            <Border StrokeShape="RoundRectangle 10"
                    BackgroundColor="#1b263b">
                <VerticalStackLayout Padding="10">

                    <Grid ColumnDefinitions="*, *, *"
                          RowDefinitions="Auto, Auto">

                        <Label Grid.Row="0" Grid.Column="0" Text="Adultos:" />
                        <Label x:Name="lbl_adultos" Grid.Row="0" Grid.Column="1" Text="0" />
                        <Stepper x:Name="stp_adultos" Grid.Row="0" Grid.Column="2"
                                 Minimum="0" Maximum="10" Increment="1"
                                 ValueChanged="Adultos_ValueChanged" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" />
                        <Label x:Name="lbl_criancas" Grid.Row="1" Grid.Column="1" Text="0" />
                        <Stepper x:Name="stp_criancas" Grid.Row="1" Grid.Column="2"
                                 Minimum="0" Maximum="10" Increment="1"
                                 ValueChanged="Criancas_ValueChanged" />
                    </Grid>

                    <Label Text="Escolha sua Suíte"
                           FontSize="18"
                           TextColor="#ffb703"
                           Margin="0, 15, 0, 0" />
                    <Label Text="Selecione sua Acomodação" />

                    <Picker x:Name="pck_quarto"
                            Title="Escolha o quarto"
                            TextColor="White"
                            TitleColor="#9aa5b1" />

                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 10"
                    BackgroundColor="#1b263b"
                    Margin="0, 20, 0, 0">
                <VerticalStackLayout Padding="10" Spacing="10">

                    <Label Text="Período da Estadia"
                           FontSize="18"
                           TextColor="#ffb703" />

                    <Grid ColumnDefinitions="*, *"
                          RowDefinitions="Auto, Auto"
                          RowSpacing="10">

                        <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" />
                        <DatePicker x:Name="dtpck_checkin" Grid.Row="0" Grid.Column="1"
                                    Format="dd/MM/yyyy"
                                    TextColor="White"
                                    DateSelected="dtpck_checkin_DateSelected" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Check-out:" />
                        <DatePicker x:Name="dtpck_checkout" Grid.Row="1" Grid.Column="1"
                                    Format="dd/MM/yyyy"
                                    TextColor="White" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Button Text="Avançar"
                    Clicked="Avancar_Clicked"
                    Margin="0, 20, 0, 0" />

            <Button Text="Minhas Reservas"
                    Clicked="Reservas_Clicked"
                    BackgroundColor="#415a77"
                    Margin="0, 10, 0, 0" />

            <Button Text="Sobre"
                    Clicked="Sobre_Clicked"
                    BackgroundColor="#415a77"
                    Margin="0, 10, 0, 20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>